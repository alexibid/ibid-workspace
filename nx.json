{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/*.yml"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    }
  ],
  "analytics": false,
  "targetDefaults": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": [
            "eslint"
          ]
        }
      ]
    },
    "@nx/angular:ng-packagr-lite": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "@nx/angular:unit-test": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "@angular/build:application": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/{projectName}",
        "browser": "{projectRoot}/src/main.ts",
        "index": "{projectRoot}/src/index.html",
        "tsConfig": "{projectRoot}/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "{projectRoot}/public"
          },
          {
            "glob": "**/*",
            "input": "libs/ibid-ui/assets",
            "output": "."
          }
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "."
          ]
        }
      },
      "configurations": {
        "production": {
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "watch": false,
        "isolate": true,
        "runnerConfig": "tools/vitest/runner.config.ts"
      }
    },
    "@angular/build:dev-server": {
      "continuous": true,
      "configurations": {
        "production": {
          "buildTarget": "{projectName}:build:production"
        },
        "development": {
          "buildTarget": "{projectName}:build:development"
        }
      }
    },
    "desktop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tauri dev --config platforms/desktop/src-tauri/tauri.conf.json",
        "cwd": "{projectRoot}"
      }
    },
    "desktop-build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/{projectName}"
      ],
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "CARGO_TARGET_DIR": "../../dist/{projectName}/desktop"
        },
        "commands": [
          "cd ../.. && node tools/builder/sync-app-version.mjs --project {projectName}",
          "tauri build --config platforms/desktop/src-tauri/tauri.conf.json",
          "cd ../.. && node tools/builder/collect-artifact.mjs --project {projectName} --from {projectRoot}/platforms/dist/{projectName}/desktop/release/bundle --ext dmg,msi,exe,deb,rpm,AppImage"
        ],
        "parallel": false
      }
    },
    "mobile-sync": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "{projectRoot}/platforms/mobile",
        "commands": [
          "cd ../../../.. && node tools/builder/sync-app-version.mjs --project {projectName}",
          "npx cap sync"
        ],
        "parallel": false
      }
    },
    "mobile-android": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "mobile-sync"
      ],
      "options": {
        "command": "npx cap run android",
        "cwd": "{projectRoot}/platforms/mobile"
      }
    },
    "mobile-ios": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "mobile-sync"
      ],
      "options": {
        "command": "npx cap run ios",
        "cwd": "{projectRoot}/platforms/mobile"
      }
    },
    "mobile-apk": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/{projectName}"
      ],
      "dependsOn": [
        "mobile-sync"
      ],
      "options": {
        "cwd": "{projectRoot}/platforms/mobile/android",
        "commands": [
          "chmod +x gradlew && ./gradlew assembleRelease",
          "cd ../../../../.. && node tools/builder/collect-artifact.mjs --project {projectName} --from {projectRoot}/platforms/mobile/android/app/build/outputs/apk/release --ext apk"
        ],
        "parallel": false
      }
    }
  },
  "generators": {
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:component": {
      "style": "scss"
    },
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-angular"
    }
  },
  "release": {
    "projectsRelationship": "independent",
    "projects": [
      "apps/*",
      "libs/*"
    ],
    "releaseTag": {
      "pattern": "{projectName}-v{version}"
    },
    "version": {
      "fallbackCurrentVersionResolver": "disk",
      "generatorOptions": {
        "updateDependents": "auto"
      },
      "git": {
        "commit": false,
        "tag": false,
        "stageChanges": false
      }
    }
  }
}
