    {
      "title": "Links e pastas",
      "actions": [
        {
          "key": "open-folder:workspace",
          "label": "Pasta do workspace",
          "run": "open",
          "args": [
            "{workspace}"
          ]
        },
        {
          "key": "open-folder:dist",
          "label": "Pasta dist (instaladores)",
          "run": "open",
          "args": [
