{
  "groups": [
    {
      "title": "Entrega",
      "actions": [
        {
          "key": "deploy-pipeline",
          "label": "Deploy & release (PR automática e publicação)",
          "run": "terminal",
          "args": [
            "deploy-pipeline"
          ]
        },
        {
          "key": "watch-ci",
          "label": "Abrir o painel do CI (gráfico + registos)",
          "run": "background",
          "args": [
            "watch-ci"
          ]
        }
      ]
    },
    {
      "title": "Runners e Docker",
      "actions": [
        {
          "key": "docker-start",
          "label": "Ligar o Docker",
          "run": "background",
          "args": [
            "docker-start"
          ]
        },
        {
          "key": "runner-start:docker",
          "label": "Ligar o runner do Docker",
          "run": "background",
          "args": [
            "runner-start",
            "docker"
          ]
        },
        {
          "key": "runner-stop:docker",
          "label": "Desligar o runner do Docker",
          "run": "background",
          "args": [
            "runner-stop",
            "docker"
          ]
        },
        {
          "key": "runner-restart:docker",
          "label": "Reiniciar o runner do Docker",
          "run": "background",
          "args": [
            "runner-restart",
            "docker"
          ]
        },
        {
          "key": "runner-register:docker",
          "label": "Registar o runner do Docker no GitHub",
          "run": "terminal",
          "args": [
            "runner-register"
          ]
        },
        {
          "key": "runner-log:docker",
          "label": "Ver o registo do runner do Docker",
          "run": "terminal",
          "args": [
            "runner-log",
            "docker"
          ]
        },
        {
          "key": "runner-start:mac",
          "label": "Ligar o runner do Mac",
          "run": "background",
          "args": [
            "runner-start",
            "mac"
          ]
        },
        {
          "key": "runner-stop:mac",
          "label": "Desligar o runner do Mac",
          "run": "background",
          "args": [
            "runner-stop",
            "mac"
          ]
        },
        {
          "key": "runner-restart:mac",
          "label": "Reiniciar o runner do Mac",
          "run": "background",
          "args": [
            "runner-restart",
            "mac"
          ]
        },
        {
          "key": "runner-log:mac",
          "label": "Ver o registo do runner do Mac",
          "run": "terminal",
          "args": [
            "runner-log",
            "mac"
          ]
        },
        {
          "key": "container-start:ibid-ci-runner",
          "label": "Ligar o contentor ibid-ci-runner",
          "run": "background",
          "args": [
            "container-start",
            "ibid-ci-runner"
          ]
        },
        {
          "key": "container-start:papikapi-api",
          "label": "Ligar o contentor papikapi-api",
          "run": "background",
          "args": [
            "container-start",
            "papikapi-api"
          ]
        },
        {
          "key": "container-start:ibid-agents-database",
          "label": "Ligar o contentor ibid-agents-database",
          "run": "background",
          "args": [
            "container-start",
            "ibid-agents-database"
          ]
        }
      ]
    },
    {
      "title": "Workspace",
      "actions": [
        {
          "key": "check-fast",
          "label": "Verificação rápida (check:fast)",
          "run": "terminal",
          "args": [
            "check-fast"
          ]
        },
        {
          "key": "check-build",
          "label": "Build do workspace (check:build)",
          "run": "terminal",
          "args": [
            "check-build"
          ]
        },
        {
          "key": "submodule-update",
          "label": "Puxar todos os submódulos",
          "run": "terminal",
          "args": [
            "submodule-update"
          ]
        },
        {
          "key": "submodule-push",
          "label": "Enviar todos os submódulos",
          "run": "terminal",
          "args": [
            "submodule-push"
          ]
        },
        {
          "key": "submodule-status",
          "label": "Estado dos submódulos",
          "run": "terminal",
          "args": [
            "submodule-status"
          ]
        },
        {
          "key": "split-sync",
          "label": "Sincronizar o monorepo com o GitHub (split)",
          "run": "terminal",
          "args": [
            "split-sync"
          ]
        },
        {
          "key": "split-pull",
          "label": "Puxar os repositórios para o monorepo",
          "run": "terminal",
          "args": [
            "split-pull"
          ]
        },
        {
          "key": "deploy-web:all",
          "label": "Deploy de todas as apps web no Firebase",
          "run": "terminal",
          "args": [
            "deploy-web",
            "all"
          ]
        },
        {
          "key": "sync-drive",
          "label": "Enviar os instaladores para o Google Drive",
          "run": "terminal",
          "args": [
            "sync-drive"
          ]
        }
      ]
    },
    {
      "title": "Oh Save Me!",
      "actions": [
        {
          "key": "auto-pr:oh-save-me",
          "label": "Criar PR para o monorepo",
          "run": "terminal",
          "args": [
            "auto-pr",
            "oh-save-me"
          ]
        },
        {
          "key": "build-all:oh-save-me",
          "label": "Build de tudo (.dmg + .apk)",
          "run": "terminal",
          "args": [
            "build-all",
            "oh-save-me"
          ]
        },
        {
          "key": "build-desktop:oh-save-me",
          "label": "Build desktop (.dmg)",
          "run": "terminal",
          "args": [
            "build-desktop",
            "oh-save-me"
          ]
        },
        {
          "key": "build-apk:oh-save-me",
          "label": "Build Android (.apk)",
          "run": "terminal",
          "args": [
            "build-apk",
            "oh-save-me"
          ]
        },
        {
          "key": "install-desktop:oh-save-me",
          "label": "Instalar no Mac (.dmg)",
          "run": "terminal",
          "args": [
            "install-desktop",
            "oh-save-me"
          ]
        },
        {
          "key": "install-mobile:oh-save-me",
          "label": "Instalar no telemóvel (USB)",
          "run": "terminal",
          "args": [
            "install-mobile",
            "oh-save-me"
          ]
        },
        {
          "key": "deploy-web:oh-save-me",
          "label": "Deploy no Firebase Hosting",
          "run": "terminal",
          "args": [
            "deploy-web",
            "oh-save-me"
          ]
        },
        {
          "key": "open-web:oh-save-me",
          "label": "Abrir a versão online",
          "run": "open",
          "args": [
            "https://ibid-ohsaveme.web.app"
          ]
        },
        {
          "key": "open-github-desktop:oh-save-me",
          "label": "Abrir no GitHub Desktop",
          "run": "open",
          "args": [
            "-a",
            "GitHub Desktop",
            "{workspace}/apps/oh-save-me"
          ]
        },
        {
          "key": "open-folder:oh-save-me",
          "label": "Abrir a pasta",
          "run": "open",
          "args": [
            "{workspace}/apps/oh-save-me"
          ]
        }
      ]
    },
