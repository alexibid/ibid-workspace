{
  "hosting": [
    {
      "target": "oh-save-me",
      "public": "dist/oh-save-me/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "boilerplate",
      "public": "dist/boilerplate/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "papikapi",
      "public": "dist/papikapi/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "storybook",
      "public": "dist/storybook/boilerplate",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "assets",
      "public": "dist/assets-site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        },
        {
          "source": "**/index.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "ibid-website",
      "public": "dist/ibid-website/browser",
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "regex": "^/[\\w.]+-[A-Za-z0-9_-]{8}\\.(?:js|css)$",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "regex": "^/(?:[^.]*|service-worker\\.js|.*\\.(?:html|json|txt|xml|webmanifest|webp|avif|jpe?g|png|gif|svg))$",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "regex": "^/favicon\\.ico$",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
        }
      ],
      "rewrites": [
        {
          "source": "/api/v1/contact",
          "function": {
            "functionId": "sendContactMessage",
            "region": "europe-west1"
          }
        },
        {
          "regex": "^/(?:.*/)?[^/.]*$",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "apps/ibid-website/functions",
      "codebase": "ibid-website",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.spec.ts",
        "src/**/*.spec.ts",
        "vitest.config.mts",
        "eslint.config.mjs"
      ],
      "predeploy": [
        "npx nx build ibid-website-functions"
      ]
    }
  ]
}
