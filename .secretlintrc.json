{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-basicauth",
          "options": {
            "allows": ["/https?:\\/\\/(user|username|utilizador):(pass|password|palavra-passe)@/i"]
          }
        },
        {
          "id": "@secretlint/secretlint-rule-privatekey",
          "options": {
            "allows": ["/EXAMPLE|DUMMY|SAMPLE|PLACEHOLDER/i"]
          }
        }
      ]
    }
  ]
}
